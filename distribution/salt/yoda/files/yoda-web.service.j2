[Unit]
Description=Yoda Stateless Web Tier (Portal, DavRODS, Public, EUS)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ yoda.rendered_dir }}/web-tier
ExecStart=/usr/bin/env {{ yoda.compose_cmd }} --env-file {{ yoda.config_dir }}/secrets.env -f {{ yoda.rendered_dir }}/web-tier/docker-compose.yml up -d --remove-orphans
ExecReload=/usr/bin/env {{ yoda.compose_cmd }} --env-file {{ yoda.config_dir }}/secrets.env -f {{ yoda.rendered_dir }}/web-tier/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/env {{ yoda.compose_cmd }} --env-file {{ yoda.config_dir }}/secrets.env -f {{ yoda.rendered_dir }}/web-tier/docker-compose.yml down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
